# .env holds SESSION_SECRET and OWNER_PASSWORD. Editors leave copies of it
# next to it under names this list has to cover too: a nano session on bastion
# produced .env.save, .env.save.1 and ..env.swp, none of which .env matches.
# They are untracked either way — the risk is one `git add -A` turning three
# stray files into published credentials.
.env
.env.*
!.env.example
.*.swp
*.swp
__pycache__/
*.pyc
data/bsdata/
data/*.db
data/*.db-wal
data/*.db-shm
# Photos of Clay's models. Data, not source — they live on the volume beside
# the database and travel in the backup, never in the repository.
data/photos/
venv/
.venv/
.pytest_cache/
.coverage
.DS_Store
