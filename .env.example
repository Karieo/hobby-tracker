# Copy to .env and edit. Never commit .env.

# Owner account, seeded on first run with an empty users table.
OWNER_NAME=Clay
OWNER_PASSWORD=changeme

# Signs the session cookie. Generate one, and keep it stable — changing it
# signs everyone out.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# IANA zone. Every timestamp is naive local wall-clock, so on a container
# defaulting to UTC "finished this week" reads hours off without this.
# Use the zone, not CST/CDT — the zone handles the switch in November on its
# own, a fixed offset does not.
TIMEZONE=America/Chicago

# Symbol for prices. Stored in cents either way; this only decides what is
# drawn. USD, GBP, EUR, CAD, AUD, NZD; anything else prints the code itself.
CURRENCY=USD

PORT=3100

# ── Backups ──────────────────────────────────────────────
# This database is dozens of hours of manual entry with no upstream source —
# nothing can reconstruct which of your Boyz are primed. Set these before there
# is data worth losing, then run ./restore.sh --check to prove it works.
#
# Only BACKUP_DIR is required. The rest are optional and safe to leave unset or
# commented out.

# Where nightly snapshots and CSV exports are written. Required.
BACKUP_DIR=/mnt/t7/hobby-tracker

# Off-box copy over SSH, as user@host:path. Strongly recommended: one Jetson
# with one external drive is one failure away from starting over.
BACKUP_DEST=

# Private key for unattended cron runs, if BACKUP_DEST needs one.
# BACKUP_SSH_KEY=~/.ssh/id_ed25519

# How many dated snapshots to keep.
BACKUP_KEEP=14
