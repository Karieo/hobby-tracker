# Copy to .env and edit. Never commit .env.

# Owner account, seeded on first run with an empty users table.
OWNER_NAME=Clay
OWNER_PASSWORD=changeme

# Signs the session cookie. Generate one, and keep it stable — changing it
# signs everyone out.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# IANA zone. Every timestamp is naive local wall-clock, so on a container
# defaulting to UTC "finished this week" reads hours off without this.
TIMEZONE=America/New_York

PORT=3100

# ── Backups ──────────────────────────────────────────────
# This database is dozens of hours of manual entry with no upstream source —
# nothing can reconstruct which of your Boyz are primed. Set these before there
# is data worth losing, and verify a restore early.
BACKUP_DIR=/mnt/t7/hobby-tracker
BACKUP_DEST=
# BACKUP_SSH_KEY=~/.ssh/id_ed25519
BACKUP_KEEP=14
