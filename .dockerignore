# Keep the image small and never bake in local state or secrets.
.git
.gitignore
venv/
.venv/
__pycache__/
*.pyc
tests/
.pytest_cache/
.env
*.db
*.db-wal
*.db-shm
data/*.db*
# 65 MB of catalogues that the image does not need: docker-compose mounts
# ./data over /app/data, so the importer reads the host's copy. Leaving it in
# the build context just makes every build slower.
data/bsdata/
.DS_Store
*.log
handoff.md
